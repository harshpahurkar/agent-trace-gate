# Copy to .env to override defaults — the agenttrace CLI loads this file at
# startup (values already exported in your shell win). Everything works
# without it.

# Where the checkpoint engine sends OTLP/HTTP spans. Jaeger v2 and the
# grafana/otel-lgtm image both listen here out of the box.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Hard wall-clock limit for each sandboxed smoke run, in seconds.
AGENTTRACE_TIMEOUT=20
