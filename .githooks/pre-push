#!/bin/sh
# agent-trace-gate — the merge gate, running locally.
#
# Blocks a push when AI-authored files among the outgoing commits produce an
# unexpected checkpoint verdict. This is the same `agenttrace check` a CI job
# would run, minus the CI: no hosted runner, no minutes, no billing account.
#
#   install:  git config core.hooksPath .githooks
#   bypass:   git push --no-verify
#
# git feeds us one line per ref being pushed on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 0
cd "$repo_root" || exit 0

# Prefer the repo's virtualenv, then whatever is on PATH.
if [ -x ".venv/bin/agenttrace" ]; then
  agenttrace=".venv/bin/agenttrace"
elif [ -x ".venv/Scripts/agenttrace.exe" ]; then
  agenttrace=".venv/Scripts/agenttrace.exe"
elif command -v agenttrace >/dev/null 2>&1; then
  agenttrace="agenttrace"
else
  echo "pre-push: agenttrace is not installed — gate skipped."
  echo "          install it with:  pip install -e ./checkpoints"
  exit 0
fi

zero=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')
status=0

resolve_base() {
  # $1 = remote oid for this ref
  if [ "$1" != "$zero" ] && git cat-file -e "$1^{commit}" 2>/dev/null; then
    echo "$1"          # everything the remote already has
    return
  fi
  for candidate in origin/main main origin/master master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
      echo "$candidate" # new branch: compare against the default branch
      return
    fi
  done
  echo ""
}

while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$zero" ] && continue   # branch deletion, nothing to gate

  base=$(resolve_base "$remote_oid")
  if [ -z "$base" ]; then
    echo "pre-push: no base revision to diff against — gate skipped."
    continue
  fi

  echo "pre-push: checkpoint gate, $base...${local_oid}"
  if ! "$agenttrace" check --base "$base" --head "$local_oid" --report ci; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "pre-push: BLOCKED - a checkpoint verdict did not match expectations."
  echo "          inspect the trace in Jaeger, or push anyway with --no-verify."
fi

exit "$status"
